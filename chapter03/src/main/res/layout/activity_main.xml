<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World! Please select the page to test."
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btn_text_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Text Color Activity" />

    <Button
        android:id="@+id/btn_text_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Text Size Activity" />

    <Button
        android:id="@+id/btn_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Text View Activity" />

    <Button
        android:id="@+id/btn_view_border"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Border Activity" />

    <Button
        android:id="@+id/btn_view_gravity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Gravity Activity" />

    <Button
        android:id="@+id/btn_view_margin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Margin Activity" />

</LinearLayout>